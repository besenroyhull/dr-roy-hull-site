---
// src/pages/faculty.astro
import TerminalLayout from '../layouts/TerminalLayout.astro';
---

<TerminalLayout title="Faculty Dossier | Dr. Besen Roy Hull" clearance="CLEARANCE: LEVEL 4-FACULTY">
  
  <div class="flex justify-between items-center text-xs text-emerald-500 mb-4">
    <a href="/" class="text-emerald-400 hover:underline font-bold">&lt;&lt; RETURN_TO_TERMINAL</a>
  </div>

  <header class="mb-6">
    <div class="text-xs text-amber-500 uppercase tracking-wider mb-1">[ PERSONNEL_DOSSIER: #00481-HULL ]</div>
    <h1 class="text-3xl font-bold text-emerald-400 drop-shadow-[0_0_10px_rgba(52,211,153,0.3)]">Dr. Besen Roy Hull</h1>
    <p class="text-xs text-slate-400 uppercase tracking-widest mt-1 mb-3">Chair of Non-Linear Narrative Mechanics<br />Milky Way Institute of Technology</p>

    <div class="text-xs bg-slate-950/80 border-l-2 border-amber-500 p-2.5 rounded-r text-slate-300">
      <span class="text-amber-500 font-bold">PRONUNCIATION_NOTE:</span> <code class="text-emerald-400 font-bold">BAY-sen</code> / /ˈbeɪ.sən/
      <div class="text-[11px] text-slate-400 italic mt-0.5">*Operatives failing to emphasize the long 'A' will be remanded to sector remediation.</div>
    </div>
  </header>

  <section class="bg-slate-950/80 border border-emerald-500/20 rounded p-4 mb-6">
    <h2 class="text-sm font-bold text-emerald-400 border-b border-emerald-500/20 pb-2 mb-3">// ACADEMIC_SUMMARY</h2>
    <p class="text-xs text-slate-300 leading-relaxed mb-3">
      Dr. Besen Roy Hull currently serves as Chair and Distinguished Fellow of Non-Linear Narrative Mechanics. His primary research focuses on causality paradoxes, space opera narrative dynamics, and the strategic deployment of comedic timing across hyper-dimensional sectors.
    </p>
    <p class="text-xs text-slate-300 leading-relaxed">
      Known for refusing to publish timeline events in chronological order, Dr. Roy Hull's archives remain essential reading for operatives navigating high-entropy universe sectors.
    </p>
  </section>

</TerminalLayout>
