---
// src/pages/dossier.astro
import TerminalLayout from '../layouts/TerminalLayout.astro';
---

<TerminalLayout title="Lore & Sector Dossier | Dr. Besen Roy Hull" clearance="ARCHIVE_INDEX: SECTOR_7B">
  
  <!-- Return Link -->
  <div class="flex justify-between items-center text-xs text-emerald-500 mb-4">
    <a href="/" class="text-emerald-400 hover:underline font-bold">&lt;&lt; RETURN_TO_TERMINAL</a>
  </div>

  <!-- Dossier Header -->
  <header class="mb-6">
    <div class="text-xs text-amber-500 font-bold uppercase tracking-wider mb-1">[ ARCHIVAL_DOSSIER: SUBJECT_VELCH ]</div>
    <h1 class="text-3xl font-black text-emerald-400 tracking-tight drop-shadow-[0_0_10px_rgba(52,211,153,0.3)] mb-1">
      The Legend of Grader Velch
    </h1>
    <p class="text-xs text-slate-400 uppercase tracking-widest font-semibold">
      Declassified Research Notes & Sector Anomalies
    </p>
  </header>

  <!-- Subject Profile Block -->
  <section class="bg-slate-950/80 border border-emerald-500/20 rounded-lg p-4 sm:p-5 mb-6">
    <h2 class="text-xs sm:text-sm font-bold text-emerald-400 border-b border-emerald-500/20 pb-2 mb-3">// SUBJECT_PROFILE: VELCH, G.</h2>
    <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-3">
      Operative Grader Velch remains one of the most polarizing figures in non-linear galactic history. Depending on which sector records you intercept, Velch is either a tactical genius who single-handedly reshaped hyper-dimensional strategy, or the catalyst for the most catastrophically absurd misunderstandings in the known universe.
    </p>
    <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
      The archives below contain verified logs, unverified rumors, and redacted incident filings regarding his alleged "Legend."
    </p>
  </section>

  <!-- Intercepted Files Grid -->
  <section class="mb-6">
    <h2 class="text-xs sm:text-sm font-bold text-emerald-400 mb-3">// INTERCEPTED_DOSSIERS</h2>

    <!-- File Entry 1 (With Audio Fragment) -->
    <div class="mb-3 p-3.5 bg-slate-950/60 border-l-4 border-amber-500 rounded-r border-t border-b border-r border-slate-800/80">
      <div class="flex justify-between items-center text-[10px] sm:text-xs text-amber-500 font-bold mb-1">
        <span>[ FILE_081-C ]</span>
        <span class="tracking-wider">STATUS: DECLASSIFIED</span>
      </div>
      <h3 class="text-sm font-bold text-emerald-300 mb-1">Incident Report: Vectorlances Over Vela</h3>
      <p class="text-xs text-slate-400 leading-normal mb-2">
        Field notes on an emergency de-orbit from an orbital Eclipse-class War Carrier, resulting in terminal-velocity free-fall amidst heavy energy fire.
      </p>
      
      <!-- Audio Fragment -->
      <div class="bg-slate-900/90 p-2.5 rounded border border-slate-800 text-[11px] font-mono space-y-1">
        <div class="text-[10px] text-amber-500 font-bold uppercase">// BLACKBOX_AUDIO_FRAGMENT</div>
        <p><strong class="text-emerald-400">VELCH:</strong> "Mathematically speaking, as long as the heavy vectorlances are firing at the ground, they aren't firing at us!"</p>
        <p><strong class="text-slate-400">COMMAND:</strong> "Velch, you are falling from thirty thousand meters with war carrier fire raining past your face!"</p>
        <p><strong class="text-emerald-400">VELCH:</strong> "I know! Magnificent view, isn't it?"</p>
      </div>
    </div>


    <!-- File Entry 2 -->
    <div class="mb-3 p-3.5 bg-slate-950/60 border-l-4 border-amber-500 rounded-r border-t border-b border-r border-slate-800/80">
      <div class="flex justify-between items-center text-[10px] sm:text-xs text-amber-500 font-bold mb-1">
        <span>[ FILE_081-A ]</span>
        <span class="tracking-wider">STATUS: DECLASSIFIED</span>
      </div>
      <h3 class="text-sm font-bold text-emerald-300 mb-1">Incident Report: The Outer Rim Miscalculation</h3>
      <p class="text-xs text-slate-400 leading-normal">
        Initial field notes on how Velch managed to turn a routine cargo audit into a sub-sector diplomatic crisis.
      </p>
    </div>

    <!-- File Entry 3 -->
    <div class="mb-3 p-3.5 bg-slate-950/60 border-l-4 border-emerald-500 rounded-r border-t border-b border-r border-slate-800/80">
      <div class="flex justify-between items-center text-[10px] sm:text-xs text-emerald-500 font-bold mb-1">
        <span>[ FILE_081-B ]</span>
        <span class="tracking-wider">STATUS: RESTRICTED</span>
      </div>
      <h3 class="text-sm font-bold text-emerald-300 mb-1">Tactical Analysis: Causality & Luck</h3>
      <p class="text-xs text-slate-400 leading-normal">
        Dr. Roy Hull's non-linear thesis evaluating whether Velch possesses genuine foresight or is simply mathematically impossible to eliminate.
      </p>
    </div>
  </section>

</TerminalLayout>
