---
// src/pages/index.astro
import TerminalLayout from '../layouts/TerminalLayout.astro';
---

<TerminalLayout title="Dr. Besen Roy Hull | Official Transmission Hub" clearance="BEACON_ID: #481-B-HULL">

  <!-- Main Header Section -->
  <header class="mb-6">
    <h1 class="text-3xl sm:text-4xl font-black text-emerald-400 tracking-tight mb-1 drop-shadow-[0_0_10px_rgba(52,211,153,0.3)]">
      Dr. Besen Roy Hull
    </h1>
    <p class="text-xs sm:text-sm text-slate-400 uppercase tracking-widest font-semibold">
      Chair of Non-Linear Galactic Narrative Strategy
    </p>
  </header>

  <!-- Tactile Navigation Hardware Grid -->
  <nav class="grid grid-cols-2 gap-3 sm:gap-4 mb-7">
    <a href="/dossier" class="tactile-switch border border-emerald-500/40 bg-slate-900/90 text-emerald-400 hover:text-emerald-300 p-3 rounded text-center font-bold text-xs sm:text-sm tracking-wide">
      [01_DOSSIER]
    </a>
    <a href="/faculty" class="tactile-switch border border-emerald-500/40 bg-slate-900/90 text-emerald-400 hover:text-emerald-300 p-3 rounded text-center font-bold text-xs sm:text-sm tracking-wide">
      [02_FACULTY]
    </a>
    <a href="#requisitions" class="tactile-switch border border-emerald-500/40 bg-slate-900/90 text-emerald-400 hover:text-emerald-300 p-3 rounded text-center font-bold text-xs sm:text-sm tracking-wide">
      [03_SUPPLIES]
    </a>
    <a href="mailto:theguy@besenroyhull.com" class="tactile-switch border border-emerald-500/40 bg-slate-900/90 text-emerald-400 hover:text-emerald-300 p-3 rounded text-center font-bold text-xs sm:text-sm tracking-wide">
      [04_COMM]
    </a>
  </nav>

  <!-- Living Terminal Log / Excerpt Box with Classified Redactions -->
  <div class="bg-slate-950/90 border-l-4 border-emerald-500 p-4 sm:p-5 mb-6 rounded-r shadow-inner text-sm leading-relaxed text-slate-300">
    <div class="text-[10px] text-amber-500 font-bold tracking-wider mb-2 uppercase">
      [ INTERCEPTED_SIGNAL // SECTOR_7B ]
    </div>
    <p class="mb-3">
      Welcome, operative. You have intercepted the research hub for Dr. Roy Hull's non-linear archives and the escalating saga of <strong class="text-emerald-300 font-bold">Grader Velch</strong>.
    </p>
    <p class="text-xs text-slate-400 italic">
      *Notice: Certain sector logs regarding <span class="redacted px-1 rounded cursor-pointer" title="Hover to unmask">The Great Outer Rim Incident</span> remain classified under Level 4 authority.
    </p>
  </div>

  <!-- Interactive Terminal Console -->
  <div class="bg-slate-950/80 p-3 rounded border border-emerald-500/30 text-xs sm:text-sm font-mono">
    <!-- Output Scroll Area -->
    <div id="terminal-output" class="max-h-36 overflow-y-auto space-y-1 mb-2 text-slate-400">
      <div class="text-emerald-500/80">// Terminal session initialized. Type 'help' for available directives.</div>
    </div>

    <!-- Active Input Line -->
    <div class="flex items-center gap-2 text-emerald-400 font-bold">
      <span class="text-emerald-500 font-black">&gt;</span>
      <input 
        type="text" 
        id="terminal-input" 
        class="bg-transparent border-none outline-none flex-1 text-emerald-300 font-mono caret-emerald-400 p-0 m-0" 
        placeholder="Type command..."
        autocomplete="off"
        spellcheck="false"
      />
    </div>
  </div>

  <!-- Interactive Terminal Engine Script -->
  <script is:inline>
    const input = document.getElementById('terminal-input');
    const output = document.getElementById('terminal-output');

    // Customized responses for Dr. Roy Hull & Grader Velch lore
    const velchQuotes = [
      "VELCH_LOG: 'It wasn't a tactical retreat. I simply preferred fighting from the next star system.'",
      "VELCH_LOG: 'Mathematically, if I don't check the navigation sensors, the anomaly isn't there.'",
      "ALERT: Grader Velch has been banned from Sector 4 mess halls due to condiment weaponization.",
      "SYSTEM_NOTE: Velch's luck index remains statistically impossible. Primary probability algorithms offline."
    ];

    const hullQuotes = [
      "DR_HULL_NOTE: 'Linear storytelling is a crutch for people who fear temporal paradoxes.'",
      "ACADEMIC_MEMO: Reminding all operatives that Dr. Hull is pronounced BAY-sen. Violators will be reassigned.",
      "DR_HULL_NOTE: 'If your chapter order makes sense chronologically, you aren't trying hard enough.'"
    ];

    const commands = {
      'help': "AVAILABLE COMMANDS: 'velch', 'hull', 'status', 'clearance', 'clear', 'about'",
      'velch': () => velchQuotes[Math.floor(Math.random() * velchQuotes.length)],
      'hull': () => hullQuotes[Math.floor(Math.random() * hullQuotes.length)],
      'status': "ALL_SYSTEMS_NOMINAL // DEFCON 4 // DEEP_SPACE_LINK: ACTIVE",
      'clearance': "YOUR CLEARANCE: LEVEL 2 (GUEST OPERATIVE) // ELEVATION REQUEST: DENIED",
      'about': "Dr. Besen Roy Hull — Chair of Non-Linear Galactic Narrative Strategy.",
    };

    if (input) {
      input.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
          const rawCmd = this.value.trim();
          const cmd = rawCmd.toLowerCase();
          
          if (!rawCmd) return;

          // Append user command to log
          const userLine = document.createElement('div');
          userLine.className = "text-emerald-400 font-bold";
          userLine.textContent = `> ${rawCmd}`;
          output.appendChild(userLine);

          // Process command
          if (cmd === 'clear') {
            output.innerHTML = '';
          } else {
            const respLine = document.createElement('div');
            respLine.className = "text-slate-300 pl-3 border-l border-emerald-500/40";
            
            if (commands[cmd]) {
              respLine.textContent = typeof commands[cmd] === 'function' ? commands[cmd]() : commands[cmd];
            } else {
              respLine.className = "text-amber-400/90 pl-3 border-l border-amber-500/40";
              respLine.textContent = `ERROR: Command '${rawCmd}' not recognized. Type 'help' for directory.`;
            }
            output.appendChild(respLine);
          }

          // Reset input & auto-scroll
          this.value = '';
          output.scrollTop = output.scrollHeight;
        }
      });
    }
  </script>

</TerminalLayout>
