---
// src/pages/index.astro
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dr. Besen Roy Hull | Official Transmission Hub</title>
    <!-- is:inline stops Astro/Vite from stripping or bundling the external CDN -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-950 text-slate-100 font-mono min-h-screen p-4 sm:p-6" style="background-color: #020617; color: #f1f5f9; font-family: monospace;">
    <main class="max-w-2xl mx-auto border border-emerald-500/30 p-5 sm:p-6 rounded-lg bg-slate-900/60 shadow-lg shadow-emerald-500/10" style="max-width: 42rem; margin: 0 auto; border: 1px solid rgba(16, 185, 129, 0.3); padding: 1.5rem; border-radius: 0.5rem; background-color: rgba(15, 23, 42, 0.6);">
      
      <!-- Top Status Bar -->
      <div class="flex flex-wrap justify-between items-center text-xs text-emerald-500 mb-6 border-b border-emerald-500/20 pb-3 gap-2" style="display: flex; justify-content: space-between; font-size: 0.75rem; color: #10b981; margin-bottom: 1.5rem; border-bottom: 1px solid rgba(16, 185, 129, 0.2); padding-bottom: 0.75rem;">
        <span>// SYSTEM_STATUS: ONLINE</span>
        <span class="text-emerald-400/70" style="color: rgba(52, 211, 153, 0.7);">BEACON_ID: #481-B-HULL</span>
      </div>

      <!-- Header Section -->
      <header class="mb-6" style="margin-bottom: 1.5rem;">
        <h1 class="text-3xl font-bold text-emerald-400 tracking-tight mb-1" style="font-size: 1.875rem; font-weight: 700; color: #34d399; margin: 0;">Dr. Besen Roy Hull</h1>
        <p class="text-xs sm:text-sm text-slate-400 uppercase tracking-wide" style="font-size: 0.875rem; color: #94a3b8; text-transform: uppercase; margin-top: 0.25rem;">Chair of Non-Linear Galactic Narrative Strategy</p>
      </header>

      <!-- Tactical Navigation Grid -->
      <nav class="grid grid-cols-2 gap-2 sm:gap-3 mb-6 text-xs sm:text-sm" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;">
        <a href="#transmissions" style="border: 1px solid rgba(16, 185, 129, 0.3); background-color: rgba(2, 6, 23, 0.5); color: #6ee7b7; padding: 0.625rem; border-radius: 0.25rem; text-align: center; font-weight: 700; text-decoration: none;">
          [01_LOGS]
        </a>
        <a href="#dossier" style="border: 1px solid rgba(16, 185, 129, 0.3); background-color: rgba(2, 6, 23, 0.5); color: #6ee7b7; padding: 0.625rem; border-radius: 0.25rem; text-align: center; font-weight: 700; text-decoration: none;">
          [02_DOSSIER]
        </a>
        <a href="/faculty" style="border: 1px solid rgba(16, 185, 129, 0.3); background-color: rgba(2, 6, 23, 0.5); color: #6ee7b7; padding: 0.625rem; border-radius: 0.25rem; text-align: center; font-weight: 700; text-decoration: none;">
          [03_FACULTY]
        </a>
        <a href="mailto:theguy@besenroyhull.com" style="border: 1px solid rgba(16, 185, 129, 0.3); background-color: rgba(2, 6, 23, 0.5); color: #6ee7b7; padding: 0.625rem; border-radius: 0.25rem; text-align: center; font-weight: 700; text-decoration: none;">
          [04_COMM]
        </a>
      </nav>

      <!-- Welcome Transmission Block -->
      <div class="bg-slate-950/80 border-l-2 border-emerald-500 p-4 mb-6 rounded-r text-sm leading-relaxed text-slate-300" style="background-color: rgba(2, 6, 23, 0.8); border-left: 2px solid #10b981; padding: 1rem; margin-bottom: 1.5rem; color: #cbd5e1; line-height: 1.625; font-size: 0.875rem;">
        <p style="margin: 0;">
          Welcome, operative. You have successfully intercepted the official archive and transmission hub for Dr. Roy Hull's speculative fiction, non-linear research notes, and galactic logs.
        </p>
      </div>

      <!-- Action Button / Footer -->
      <div class="flex items-center justify-between pt-2 border-t border-slate-800" style="display: flex; align-items: center; justify-content: space-between; padding-top: 0.5rem; border-top: 1px solid #1e293b;">
        <div style="display: inline-block; background-color: #10b981; color: #020617; font-weight: 700; padding: 0.375rem 0.75rem; border-radius: 0.25rem; font-size: 0.875rem;">
          &gt; TRANSMISSION_ESTABLISHED
        </div>
        <span style="font-size: 0.75rem; color: #64748b; font-family: monospace;">v0.0.1</span>
      </div>

    </main>
  </body>
</html>
