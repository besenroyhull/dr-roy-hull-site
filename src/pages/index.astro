---
// src/pages/index.astro
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dr. Besen Roy Hull | Official Transmission Hub</title>
    <!-- Direct CDN fallback to guarantee styled rendering instantly -->
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body style="background-color: #020617; color: #f1f5f9; font-family: monospace; min-height: 100vh; padding: 1.5rem;">
    <main style="max-width: 42rem; margin: 0 auto; border: 1px solid rgba(16, 185, 129, 0.3); padding: 1.5rem; border-radius: 0.5rem; background-color: rgba(15, 23, 42, 0.6); box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.1);">
      <div style="font-size: 0.75rem; color: #10b981; margin-bottom: 1rem; border-bottom: 1px solid rgba(16, 185, 129, 0.2); padding-bottom: 0.5rem;">
        // SYSTEM_STATUS: ONLINE // BEACON_ID: #481-B-HULL
      </div>
      <h1 style="font-size: 1.875rem; font-weight: 700; color: #34d399; margin-bottom: 0.5rem;">Dr. Besen Roy Hull</h1>
      <p style="font-size: 0.875rem; color: #94a3b8; margin-bottom: 1.5rem;">Chair of Non-Linear Galactic Narrative Strategy</p>
      <p style="color: #cbd5e1; line-height: 1.625; margin-bottom: 1.5rem;">
        Welcome, operative. You have successfully intercepted the official archive and transmission hub for Dr. Roy Hull's speculative fiction, non-linear research notes, and galactic logs.
      </p>
      <div style="display: inline-block; background-color: #10b981; color: #020617; font-weight: 700; padding: 0.5rem 1rem; border-radius: 0.25rem; font-size: 0.875rem;">
        &gt; TRANSMISSION_ESTABLISHED
      </div>
    </main>
  </body>
</html>
