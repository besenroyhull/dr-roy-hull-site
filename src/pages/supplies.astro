---
// src/pages/supplies.astro
import TerminalLayout from '../layouts/TerminalLayout.astro';
import suppliesData from '../data/suppliesData.json';
---

<TerminalLayout title="Supplies & Requisitions | Dr. Besen Roy Hull" clearance="CATALOG_REF: SEC-07-SUPPLIES">
  
  <!-- Return Link -->
  <div class="flex justify-between items-center text-xs text-emerald-500 mb-4">
    <a href="/" class="text-emerald-400 hover:underline font-bold">&lt;&lt; RETURN_TO_TERMINAL</a>
  </div>

  <!-- Page Header -->
  <header class="mb-6">
    <div class="text-xs text-amber-500 font-bold uppercase tracking-wider mb-1">[ REQUISITIONS_DEPOT: SECTOR_7B ]</div>
    <h1 class="text-3xl font-black text-emerald-400 tracking-tight drop-shadow-[0_0_10px_rgba(52,211,153,0.3)] mb-1">
      Official Logistics & Supplies
    </h1>
    <p class="text-xs text-slate-400 uppercase tracking-widest font-semibold">
      Tactile Equipment, Field Gear, & Literature Archives
    </p>
  </header>

  <!-- Notice Box -->
  <div class="bg-slate-950/90 border-l-4 border-amber-500 p-3.5 mb-6 rounded-r text-xs text-slate-300 leading-relaxed">
    <span class="text-amber-500 font-bold block mb-1">// REQUISITION_POLICY:</span>
    All gear is manufactured on-demand via sector logistics partners upon request transmission. Items ship directly to registered operative coordinates.
  </div>

  <!-- Products Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
    {suppliesData.products.map((item) => (
      <div class="bg-slate-950/80 border border-emerald-500/30 rounded p-4 flex flex-col justify-between hover:border-emerald-500/60 transition-colors">
        <div>
          <!-- Status & Item Code -->
          <div class="flex justify-between items-center text-[10px] font-mono text-slate-400 mb-2">
            <span class="text-amber-400/90 font-bold">[{item.code}]</span>
            <span class={item.inStock ? "text-emerald-400 font-bold" : "text-amber-500 font-bold"}>
              {item.inStock ? "● READY_FOR_DISPATCH" : "▲ PENDING_PUBLICATION"}
            </span>
          </div>

          <!-- Title & Description -->
          <h3 class="text-sm font-bold text-emerald-300 mb-1">{item.title}</h3>
          <p class="text-xs text-slate-400 leading-relaxed mb-3">{item.description}</p>
        </div>

        <!-- Price & Action Button -->
        <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between mt-auto">
          <span class="text-sm font-bold text-slate-200 font-mono">${item.price}</span>
          
          {item.inStock ? (
            <a 
              href={item.checkoutUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="tactile-switch bg-emerald-500/20 border border-emerald-500/50 hover:bg-emerald-500/30 text-emerald-300 px-3 py-1.5 rounded text-xs font-bold font-mono tracking-wide no-underline text-center"
            >
              [REQUISITION]
            </a>
          ) : (
            <span class="bg-slate-900 border border-slate-800 text-slate-500 px-3 py-1.5 rounded text-xs font-bold font-mono cursor-not-allowed">
              [OUT_OF_STOCK]
            </span>
          )}
        </div>
      </div>
    ))}
  </div>

</TerminalLayout>
