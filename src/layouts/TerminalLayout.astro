---
// src/layouts/TerminalLayout.astro
interface Props {
  title: string;
  clearance?: string;
}

const { title, clearance = "CLEARANCE: LEVEL_02" } = Astro.props;
const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en" class="bg-slate-950 text-slate-100 min-h-screen">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600;700&display=swap" rel="stylesheet">

    <!-- Tailwind Play CDN (Fail-safe for styling) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              mono: ['"Fira Code"', 'monospace'],
            }
          }
        }
      }
    </script>

    <!-- Hardcoded Base Fallback CSS -->
    <style is:global>
      html, body {
        background-color: #020617 !important;
        color: #f1f5f9 !important;
        font-family: 'Fira Code', monospace !important;
        margin: 0;
        padding: 0;
      }
      a {
        color: #34d399;
      }
      .tactile-switch {
        transition: all 0.2s ease-in-out;
      }
      .tactile-switch:hover {
        transform: translateY(-1px);
        box-shadow: 0 0 12px rgba(52, 211, 153, 0.25);
      }
    </style>
  </head>
  <body class="bg-slate-950 font-mono min-h-screen flex flex-col justify-start items-center p-3 sm:p-6 antialiased selection:bg-emerald-500/30 selection:text-emerald-200">
    
    <!-- Ambient CRT Radial Glow -->
    <div class="fixed inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-slate-900/40 via-slate-950 to-slate-950 pointer-events-none -z-10"></div>

    <!-- Main Terminal Chassis Container -->
    <div class="w-full max-w-3xl bg-slate-950/90 border border-emerald-500/30 rounded-lg shadow-[0_0_25px_rgba(16,185,129,0.08)] flex flex-col min-h-[85vh] my-0">
      
      <!-- Top System Status Header -->
      <header class="border-b border-emerald-500/20 bg-slate-900/60 px-4 py-2.5 flex flex-wrap justify-between items-center text-[10px] sm:text-xs font-semibold text-slate-400 gap-2">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-emerald-400 font-bold tracking-wider">BEACON_NODE_7B</span>
        </div>
        <div class="text-slate-500 hidden sm:block">
          STATUS: <span class="text-slate-300">NOMINAL</span>
        </div>
        <div class="text-amber-500/90 font-mono tracking-wide">
          [{clearance}]
        </div>
      </header>

      <!-- Main Dynamic Content Area -->
      <main class="p-4 sm:p-8 flex-1 flex flex-col justify-start">
        <slot />
      </main>

      <!-- Footer -->
      <footer class="border-t border-emerald-500/20 bg-slate-900/40 px-4 py-5 text-xs text-slate-400 font-mono">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-4">
          <div>
            <div class="text-emerald-400 font-bold text-xs tracking-wide mb-0.5">
              DR. BESEN ROY HULL
            </div>
            <div class="text-[11px] text-slate-400">
              Chair of Non-Linear Galactic Narrative Strategy
            </div>
            <div class="text-[10px] text-slate-500 mt-1">
              © {currentYear} Dr. Besen Roy Hull. All rights reserved across timelines.
            </div>
          </div>

          <nav class="flex flex-wrap gap-3 text-[11px]">
            <a href="/dossier" class="text-slate-400 hover:text-emerald-400 transition-colors no-underline">[DOSSIER]</a>
            <a href="/faculty" class="text-slate-400 hover:text-emerald-400 transition-colors no-underline">[FACULTY]</a>
            <a href="/supplies" class="text-slate-400 hover:text-emerald-400 transition-colors no-underline">[SUPPLIES]</a>
            <a href="mailto:theguy@besenroyhull.com" class="text-slate-400 hover:text-emerald-400 transition-colors no-underline">[COMM]</a>
          </nav>
        </div>

        <div class="pt-3 border-t border-slate-800/80 flex flex-wrap justify-between items-center text-[10px] text-slate-500 gap-2">
          <span>HOSTED_ON: CLOUDFLARE_EDGE_NETWORK</span>
          <span>SEC_PROTOCOL: LEVEL_4_ENCRYPTED</span>
        </div>
      </footer>

    </div>

  </body>
</html>
