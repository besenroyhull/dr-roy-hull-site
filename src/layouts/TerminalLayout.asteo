---
// src/layouts/TerminalLayout.astro
const { title = "Dr. Besen Roy Hull | Official Transmission Hub", clearance = "CLEARANCE: LEVEL 4-TACTICAL" } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <style is:inline>
      .crt-screen {
        background: radial-gradient(circle at center, rgba(15, 23, 42, 0.95) 0%, rgba(2, 6, 23, 0.98) 100%);
        box-shadow: inset 0 0 80px rgba(0, 0, 0, 0.8), 0 0 20px rgba(16, 185, 129, 0.15);
      }
      .scanlines {
        background: linear-gradient(
          to bottom,
          rgba(255,255,255,0),
          rgba(255,255,255,0) 50%,
          rgba(0, 0, 0, 0.35) 50%,
          rgba(0, 0, 0, 0.35)
        );
        background-size: 100% 4px;
        pointer-events: none;
      }
      .terminal-cursor {
        animation: blink 1s step-end infinite;
      }
      @keyframes blink {
        50% { opacity: 0; }
      }
      .tactile-switch {
        box-shadow: 0 4px 0 #064e3b, 0 5px 10px rgba(0,0,0,0.5);
        transition: all 0.08s ease-in-out;
      }
      .tactile-switch:active {
        transform: translateY(3px);
        box-shadow: 0 1px 0 #064e3b, 0 2px 5px rgba(0,0,0,0.5);
      }
      .redacted {
        background-color: #1e293b;
        color: #1e293b;
        user-select: none;
        transition: all 0.2s ease;
      }
      .redacted:hover {
        background-color: rgba(16, 185, 129, 0.2);
        color: #34d399;
      }
    </style>
  </head>
  <body class="bg-slate-950 text-slate-100 font-mono min-h-screen p-3 sm:p-6 flex flex-col justify-center items-center relative overflow-x-hidden" style="background-color: #020617;">
    
    <!-- Outer Terminal Hardware Frame -->
    <main class="w-full max-w-2xl border-2 border-slate-800 rounded-xl p-4 sm:p-7 crt-screen relative overflow-hidden">
      
      <!-- Scanline Overlay -->
      <div class="absolute inset-0 scanlines opacity-60 z-10"></div>

      <!-- Live Header Bar -->
      <div class="relative z-20 flex justify-between items-center text-xs text-emerald-500 mb-6 border-b border-emerald-500/20 pb-3">
        <div class="flex items-center gap-2">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
          </span>
          <span class="font-bold tracking-wider">// SYSTEM_STATUS: ONLINE</span>
        </div>
        <span class="text-emerald-400/60 font-mono text-[10px] sm:text-xs">{clearance}</span>
      </div>

      <!-- PAGE CONTENT GOES HERE -->
      <div class="relative z-20">
        <slot />
      </div>

      <!-- Monitor Footer -->
      <footer class="relative z-20 flex items-center justify-between pt-5 mt-6 border-t border-slate-800 text-xs text-slate-500">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-emerald-500/80 inline-block"></span>
          <span class="font-mono">SIGNAL_STRENGTH: 99.8%</span>
        </div>
        <span class="font-mono text-slate-600">v1.0.4-TACTICAL</span>
      </footer>

    </main>

  </body>
</html>
